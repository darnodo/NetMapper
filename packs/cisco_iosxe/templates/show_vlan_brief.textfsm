Value VLAN_ID (\d+)
Value NAME (\S+)
Value STATUS (\S+)

Start
  ^VLAN\s+Name\s+Status\s+Ports\s*$$
  ^-+\s+-+\s+-+\s+-+\s*$$
  # VLANs 1002 to 1005, the legacy FDDI and Token Ring defaults every IOS-XE switch lists as
  # act/unsup, are not declared VLANs (feature 013, spec FR-006).
  ^100[2-5]\s
  ^${VLAN_ID}\s+${NAME}\s+${STATUS}(?:\s+\S.*)?\s*$$ -> Record
  # A name longer than its column (VTP version 3 allows up to 128 characters) pushes the status
  # and the ports to the next line, indented (recorded on a C9300LM, 17.9.10).
  ^${VLAN_ID}\s+${NAME}\s*$$ -> WrappedStatus
  # Ports that do not fit on the line continue on the next, indented: membership is read elsewhere.
  ^\s+\S
  ^\s*$$
  # Printed first when the vty line has `exec prompt timestamp` (recorded on a C9300LM, 17.9.10).
  ^Load\s+for\s+
  ^Time\s+source\s+is
  ^. -> Error

WrappedStatus
  ^\s+${STATUS}(?:\s+\S.*)?\s*$$ -> Record Start
  ^. -> Error

# IOS-XE takes a VLAN name as one word, so NAME is one word.
