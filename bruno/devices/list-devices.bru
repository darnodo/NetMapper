meta {
  name: List devices
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/devices
  body: none
  auth: inherit
}

params:query {
  ~snapshot: {{snapshot}}
}

script:post-response {
  // Use the first device for "Get device" and "Get interface".
  // The device key is used rather than the hostname, which can be ambiguous (409).
  const devices = res.getBody().devices || [];
  if (res.getStatus() === 200 && devices.length > 0) {
    bru.setVar("device", devices[0].device_key);
  }
}
